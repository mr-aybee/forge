---
// Replaces Starlight's site title with the website's logo. The logo links to
// the website home (/); the "Docs" pill links to the docs home (/docs/).
import mark from "../assets/forge-mark.svg";
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="forge-brand">
  <a href="/" class="forge-logo" aria-label="Orbyn Forge home">
    <img src={mark.src} alt="" width="30" height="30" />
    <span translate="no">Orbyn <span class="forge-accent">Forge</span></span>
  </a>
  <a href={siteTitleHref} class="forge-docs-pill">Docs</a>
</div>

<style>
  .forge-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .forge-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--forge-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .forge-logo img {
    width: 30px;
    height: 30px;
  }
  .forge-accent {
    color: var(--forge-accent);
  }
  .forge-docs-pill {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--forge-accent-soft);
    color: var(--forge-accent-strong);
    text-decoration: none;
  }
  .forge-docs-pill:hover {
    background: var(--forge-accent);
    color: var(--forge-on-accent);
  }
</style>
